alias c='clear'
alias fe="conda activate FERRET;pyferret -nojnl"
alias fs="conda activate FERRET;ferret -nodisplay -script"
alias cdac="conda deactivate"

alias j='py12a;jupyter-lab'
alias jd="cd /media/scilab/disk_ranjan/;j"
alias py12a="source ~/.virenv/py12/bin/activate"
alias py12ai="source ~/.virenv/py12ai/bin/activate"
alias jedi="cd /media/scilab/disk_ranjan/;py12ai;jupyter-lab"
alias sd="ncdump -h"
alias kden="flatpak run org.kde.kdenlive"
alias py39="source ~/venv_py39/bin/activate"

alias kadh="sudo fuser -kmv /media/scilab/disk_ranjan/;sudo umount -l /media/scilab/disk_ranjan"
alias music="/home/scilab/programs/MuseScore-Studio-4.5.2.251141401-x86_64.AppImage"

alias tldlt="rm *.aux *.bbl *.blg *.log *.toc *.out *tex.gz *.spl *.lot *.lof"

alias pymail="source ~/.virenv/pymail/bin/activate"
alias jlm='pymail;jupyter-lab'
alias neji="source /home/scilab/.virenv/neji/bin/activate"

alias upgrade="sudo apt-get update && sudo apt-get -y upgrade"
